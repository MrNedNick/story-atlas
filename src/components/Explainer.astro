---
import { getEntry } from 'astro:content';
import { stepInputId } from '../domain/04-explainer';
import { prepareExplainer } from '../features/04-explainer';
import { publicAssetExists } from '../adapters/assets';

interface Props {
  id: string;
}

const entry = await getEntry('explainers', Astro.props.id);
if (!entry) throw new Error(`Unknown explainer "${Astro.props.id}"`);
const { explainer, css } = prepareExplainer({ ...entry.data, id: entry.id }, publicAssetExists);
---

<figure class="explainer" data-explainer={explainer.id} data-layout="wide">
  <fieldset class="explainer-steps">
    <legend>{explainer.title}</legend>
    <div class="explainer-options">
      {
        explainer.steps.map((step) => (
          <label>
            <input
              type="radio"
              name={`explainer-${explainer.id}`}
              id={stepInputId(explainer.id, step.id)}
              checked={step.id === explainer.initial}
            />
            <span>{step.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <div class="explainer-panels">
    {
      explainer.steps.map((step) => (
        <div class="explainer-panel" data-step={step.id}>
          <img src={step.src} alt={step.alt} loading="lazy" decoding="async" />
          <p class="explainer-caption">
            <strong>{step.label}.</strong> {step.caption}
          </p>
        </div>
      ))
    }
  </div>
</figure>
<Fragment set:html={`<style>${css}</style>`} />

<style>
  .explainer {
    margin: 2rem 0;
  }

  .explainer-steps {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    font: 0.875rem/1.4 system-ui, sans-serif;
  }

  legend {
    margin-bottom: 0.5rem;
    padding: 0;
    font-weight: 600;
  }

  .explainer-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  label {
    position: relative;
  }

  /* The radio stays in the accessibility tree and takes keyboard focus; the pill is its visible face. */
  input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  label span {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  input:checked + span {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--paper);
  }

  input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .explainer-panel + .explainer-panel {
    margin-top: 1.5rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    background: #fff;
  }

  .explainer-caption {
    max-width: 38rem;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font: 0.875rem/1.4 system-ui, sans-serif;
  }
</style>
