---
import type { Illustration } from '../domain/01-content-schema';

interface Props {
  illustration: Illustration;
}

const { illustration } = Astro.props;
---

<figure class="figure" data-kind={illustration.kind}>
  <img src={illustration.src} alt={illustration.alt} loading="lazy" decoding="async" />
  {illustration.caption && <figcaption>{illustration.caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    background: #fff;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font: 0.875rem/1.4 system-ui, sans-serif;
  }
</style>
