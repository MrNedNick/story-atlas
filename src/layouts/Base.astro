---
import { absoluteUrl, metaTags } from '../domain/06-distribution';
import { siteConfig, withBase } from '../features/06-distribution';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, without the base: '' for the home page, 'stories/x/' for a story. */
  path: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** Site-relative preview image; only raster images make a picture card. */
  image?: string;
  imageAlt?: string;
}

const { title, description, path, type = 'website', publishedAt, image, imageAlt } = Astro.props;
const site = siteConfig();
const tags = metaTags(site, { title, description, path, type, publishedAt, image, imageAlt });
if (!tags.ok) throw new Error(`Page meta for "${path}": ${tags.error.kind}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={absoluteUrl(site, path)} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('rss.xml')} />
    {tags.value.map((tag) => (tag.attribute === 'property' ? <meta property={tag.key} content={tag.content} /> : <meta name={tag.key} content={tag.content} />))}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href={withBase('')} class="site-name">Story Atlas</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --text: #1d1b18;
    --muted: #5f5a52;
    --paper: #fbf9f5;
    --rule: #e3ddd2;
    --accent: #1f5f8b;
    --measure: 38rem;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #ece8e1;
      --muted: #a9a298;
      --paper: #171614;
      --rule: #34312c;
      --accent: #7fb6dd;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 0 0 4rem;
    background: var(--paper);
    color: var(--text);
    font: 1.125rem/1.6 'Iowan Old Style', Charter, 'Palatino Linotype', Georgia, serif;
    text-rendering: optimizeLegibility;
  }

  main {
    overflow-wrap: break-word;
  }

  /* Pages without the editorial grid keep to one readable column. */
  main > :not(.story) {
    max-width: var(--measure);
    margin-inline: auto;
  }

  main p {
    hyphens: auto;
  }

  h1,
  h2,
  h3 {
    font-family: system-ui, sans-serif;
    line-height: 1.2;
    text-wrap: balance;
  }

  a {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .site-header {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-family: system-ui, sans-serif;
  }

  .site-name {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
</style>
