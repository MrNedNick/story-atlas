---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Citations from '../../components/Citations.astro';
import { loadPublishedStories } from '../../adapters/content';
import type { Story } from '../../domain/01-content-schema';
import { siteLayoutCss, storyReadingMinutes } from '../../features/02-layout';
import { storyToc, tocEntryFor } from '../../features/03-navigation';
import { neighbours } from '../../domain/03-navigation';
import Contents from '../../components/Contents.astro';
import ChapterNav from '../../components/ChapterNav.astro';

export async function getStaticPaths() {
  const stories = await loadPublishedStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

interface Props {
  story: Story;
}

const { story } = Astro.props;
const chapters = await Promise.all(
  story.chapters.map(async (chapter) => {
    const entry = await getEntry('chapters', chapter.bodyRef);
    if (!entry) throw new Error(`Story "${story.slug}" points at a missing chapter body: ${chapter.bodyRef}`);
    const { Content, headings } = await render(entry);
    return { chapter, Content, headings, body: entry.body ?? '' };
  }),
);
const toc = storyToc(
  story.slug,
  chapters.map(({ chapter, body, headings }) => ({ order: chapter.order, title: chapter.title, body, headings })),
);
const minutes = storyReadingMinutes(chapters.map(({ body }) => body));
const layout = siteLayoutCss();
const date = (value: Date) => value.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base title={`${story.title} · Story Atlas`} description={story.dek}>
  <Fragment slot="head" set:html={`<style>${layout}</style>`} />
  <article class="story">
    <header class="story-header">
      <h1>{story.title}</h1>
      <p class="dek">{story.dek}</p>
      <p class="meta">
        <time datetime={story.publishedAt.toISOString()}>{date(story.publishedAt)}</time>{' '}
        · {minutes} min read
        {
          story.updatedAt && (
            <>
              {' '}
              · updated <time datetime={story.updatedAt.toISOString()}>{date(story.updatedAt)}</time>
            </>
          )
        }
      </p>
    </header>

    <Contents toc={toc} />

    {
      chapters.map(({ chapter, Content }) => {
        const entry = tocEntryFor(toc, chapter.order);
        return (
        <section class="chapter" id={entry.id} aria-labelledby={`${entry.id}-title`}>
          <h2 id={`${entry.id}-title`}>{chapter.title}</h2>
          <Content />
          {chapter.illustrations.map((illustration) => (
            <Figure illustration={illustration} />
          ))}
          <Citations citations={chapter.citations} />
          <ChapterNav neighbours={neighbours(toc, entry.id)} />
        </section>
        );
      })
    }
  </article>
</Base>

<style>
  .story-header {
    margin: 2.5rem 0 3rem;
  }

  h1 {
    margin: 0 0 1rem;
  }

  .dek {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    color: var(--muted);
  }

  .meta {
    margin: 0;
    color: var(--muted);
    font: 0.875rem/1.5 system-ui, sans-serif;
  }

  .chapter + .chapter {
    margin-top: 4rem;
  }

  /* Anchored headings land with a little room above them. */
  .chapter,
  .chapter :global(h3) {
    scroll-margin-top: 1.5rem;
  }

  .chapter h2 {
    margin: 0 0 1rem;
  }
</style>
